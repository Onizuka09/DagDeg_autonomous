<?xml version="1.0"?>
<robot name="dagdeg_bot">
  
  <!-- Base Link (20cm long × 19cm wide × 5cm tall) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2 0.19 0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <!-- LEFT DRIVE WHEEL (8cm from center) -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.0325"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.08 -0.015" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- RIGHT DRIVE WHEEL (8cm from center) -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.0325"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.08 -0.015" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- FRONT CASTER WHEEL (10cm forward, centered width) -->
  <link name="front_caster">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.1 0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- REAR CASTER WHEEL (10cm backward, centered width) -->
  <link name="rear_caster">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.1 0 -0.015" rpy="0 0 0"/>
  </joint>

</robot>
